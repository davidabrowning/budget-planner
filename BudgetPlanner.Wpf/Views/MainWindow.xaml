<Window x:Class="BudgetPlanner.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetPlanner.Wpf.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1600">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Setters>
                <Setter Property="BorderThickness" Value="0" />
            </Style.Setters>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock 
                    Text="Budget Planner" 
                    Grid.Row="0" 
                    Padding="5"
                    FontSize="32"
                    Foreground="{StaticResource AccentDarker}"
                    Background="{StaticResource AccentMedium}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" DataContext="{Binding Path=TransactionsListViewModel}">
                <ListView ItemsSource="{Binding Path=TransactionsView}" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=Name}" Padding="5" FontWeight="Bold"
                                               Foreground="{StaticResource AccentDarker}"
                                               Background="{StaticResource AccentMedium}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="EditTransactionButton" 
                                    Click="EditTransactionButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="{StaticResource AccentLightest}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=Amount, StringFormat={}{0}:-}" Padding="5" Width="100" />
                                    <TextBlock Text="{Binding Path=Category}" Padding="5" Width="100" />
                                    <TextBlock Text="{Binding Path=Frequency, StringFormat=({0})}" Padding="5" Width="100" />
                                    <TextBlock Text="{Binding Path=Comment, StringFormat=Comment: {0}}" Padding="5" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.Resources>
                    <Style TargetType="Button">
                        <Style.Setters>
                            <Setter Property="Foreground" Value="{StaticResource AccentLighter}" />
                            <Setter Property="Background" Value="{StaticResource AccentDarker}" />
                            <Setter Property="Padding" Value="15" />
                            <Setter Property="Padding" Value="15" />
                        </Style.Setters>
                    </Style>
                </Grid.Resources>
                <TabControl x:Name="AddEditTransactionTabGroup">
                    <TabItem x:Name="AddTab" Header="Add new">
                        <StackPanel DataContext="{Binding Path=AddTransactionViewModel}">
                            <Label Content="Comment:" />
                            <TextBox x:Name="NewComment" Text="" />
                            
                            <Label Content="Amount:" />
                            <TextBox x:Name="NewAmount" Text="" />

                            <Label Content="Year:" />
                            <TextBox x:Name="NewYear" 
                                         Text="{Binding Path=DefaultYear, Mode=OneWay}" />

                            <Label Content="Month:" />
                            <ListBox x:Name="NewMonth" 
                                         ItemsSource="{Binding Path=AllMonths}" 
                                         SelectedItem="{Binding Path=DefaultMonth, Mode=OneWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <Label Content="Category:"/>
                            <ListBox x:Name="NewCategory" 
                                         ItemsSource="{Binding Path=AllCategories}"
                                         SelectedItem="{Binding Path=DefaultCategory, Mode=OneWay}" />

                            <Label Content="Frequency:" />
                            <ListBox x:Name="NewFrequency" 
                                         ItemsSource="{Binding Path=AllFrequencies}" 
                                         SelectedItem="{Binding Path=DefaultFrequency, Mode=OneWay}"/>

                            <Button x:Name="AddTransactionButton"
                                        Content="Add transaction"
                                        Click="AddTransactionButton_Click"
                                        Margin="5"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="EditTab" Header="Edit">
                        <StackPanel DataContext="{Binding Path=EditTransactionViewModel}">
                            <Label Content="Comment:"/>
                            <TextBox x:Name="EditComment" 
                                        Text="{Binding Path=SelectedTransaction.Comment, Mode=OneWay}" />
                            
                            <Label Content="Amount:"/>
                            <TextBox x:Name="EditAmount" 
                                        Text="{Binding Path=SelectedTransaction.Amount, Mode=OneWay}" />

                            <Label Content="Year:"/>
                            <TextBox x:Name="EditYear" 
                                        Text="{Binding Path=SelectedTransaction.Year, Mode=OneWay}" />

                            <Label Content="Month:"/>
                            <ListBox x:Name="EditMonth"
                                        ItemsSource="{Binding Path=AllMonths}" 
                                        SelectedItem="{Binding Path=SelectedTransaction.Month, Mode=OneWay}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <Label Content="Category:"/>
                            <ListBox x:Name="EditCategory" 
                                         ItemsSource="{Binding Path=AllCategories}" 
                                         SelectedItem="{Binding Path=SelectedTransaction.Category, Mode=OneWay}" />

                            <Label Content="Frequency:"/>
                            <ListBox x:Name="EditFrequency" 
                                         ItemsSource="{Binding Path=AllFrequencies}" 
                                         SelectedItem="{Binding Path=SelectedTransaction.Frequency, Mode=OneWay}" />

                            <Button x:Name="SaveChangesTransactionButton"
                                        Content="Save changes"
                                        Click="SaveChangesTransactionButton_Click"
                                        Margin="5"/>

                            <Button x:Name="DeleteTransactionButton"
                                        Content="Delete transaction"
                                        Click="DeleteTransactionButton_Click"
                                        Margin="5"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="MonthlyForecast" Header="Monthly Forecast">
                        <StackPanel DataContext="{Binding Path=MonthlyForecastViewModel}">
                            <ListView ItemsSource="{Binding Path=MonthlySummaryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Path=Month}" Margin="5" />
                                            <TextBlock Text="{Binding Path=Incomes}" Margin="5" />
                                            <TextBlock Text="{Binding Path=Expenses}" Margin="5" />
                                            <TextBlock Text="=>" Margin="5" />
                                            <TextBlock Text="{Binding Path=Net}" Margin="5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=CurrentYear}" Margin="5" />
                                <TextBlock Text="{Binding Path=TotalIncomes}" Margin="5" />
                                <TextBlock Text="{Binding Path=TotalExpenses}" Margin="5" />
                                <TextBlock Text="=>" Margin="5" />
                                <TextBlock Text="{Binding Path=TotalNet}" Margin="5" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
