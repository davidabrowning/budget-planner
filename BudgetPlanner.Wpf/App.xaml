<Application x:Class="BudgetPlanner.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BudgetPlanner.Wpf"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentLightest" Color="White" />
        <SolidColorBrush x:Key="AccentLighter" Color="#FFFBB1" />
        <SolidColorBrush x:Key="AccentLight" Color="#D8E983" />
        <SolidColorBrush x:Key="AccentMedium" Color="#A5C89E" />
        <SolidColorBrush x:Key="AccentDark" Color="#AEB877" />
        <SolidColorBrush x:Key="AccentDarker" Color="#36656B" />
        <SolidColorBrush x:Key="AccentDarkest" Color="Black" />
    </Application.Resources>
</Application>
